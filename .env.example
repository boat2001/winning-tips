# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://winningtips:change-me@localhost:5432/winningtips?schema=public"

# Public canonical URL. Update this in each deployed environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
GOOGLE_SITE_VERIFICATION=""

# Runtime environment label used in logs and diagnostics.
APP_ENV="development"
CRON_SECRET="replace-with-a-long-random-secret"
# Paystack hosted checkout and webhook verification. Use sk_test_... locally.
PAYSTACK_SECRET_KEY=""

# Seed demo content (mock fixtures, sample predictions, demo slips) alongside the
# decks and plans. Leave unset for any real database - it defaults to off so the
# seed cannot drop fake matches into production.
SEED_DEMO_DATA="false"

# Optional: creates or promotes a super-admin when `npm run db:seed` runs.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_USERNAME="winningtips-admin"
SEED_ADMIN_PASSWORD=""
PROTECTED_SUPER_ADMIN_USERNAMES="boatenberg"

# --- Football data feed -------------------------------------------------------
# Which provider supplies fixtures and results. "mock" is a deterministic
# development feed and is REFUSED in staging and production, so a deployment
# without a real key syncs nothing rather than writing invented fixtures.
FOOTBALL_PROVIDER="mock"

# API-Football key from https://dashboard.api-football.com (or your RapidAPI
# key if you set FOOTBALL_API_BASE_URL to the RapidAPI host). Required when
# FOOTBALL_PROVIDER="api-football".
FOOTBALL_API_KEY=""

# Optional overrides.
# FOOTBALL_API_BASE_URL="https://v3.football.api-sports.io"
# FOOTBALL_API_TIMEOUT_MS="15000"

# Optional allowlist of API-Football league ids. Empty means every league the
# date returns. Filtering happens after the request, so the list costs no extra
# quota: one date is always one request.
# Stable, widely-documented ids:
#   39 Premier League · 140 La Liga · 135 Serie A · 78 Bundesliga
#   61 Ligue 1 · 2 UEFA Champions League
# Confirm African league ids against GET /leagues?country=Ghana in your own
# dashboard before relying on them - they are not stable across seasons.
FOOTBALL_LEAGUE_IDS=""

# --- Basketball feed -----------------------------------------------------------
# Off by default. Set to "api-basketball" to sync games nightly with football.
# There is no tennis feed: API-Sports does not cover tennis. Tennis legs loaded
# from SportyBet slips are still published.
BASKETBALL_PROVIDER="disabled"

# Optional. One API-Sports account covers football and basketball, so this falls
# back to FOOTBALL_API_KEY when unset.
API_SPORTS_KEY=""

# Optional allowlist of API-Basketball league ids, e.g. "12" for the NBA.
BASKETBALL_LEAGUE_IDS=""

# --- Telegram digest -------------------------------------------------------------
# Posts each morning's settled results and the free card to your channel.
# Create a bot with @BotFather, add it to the channel as an admin, and use the
# channel's @username or numeric id. Delivery is skipped unless both are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Renders the member screens from demo fixtures instead of the database.
# Development only - it is ignored unless NODE_ENV is "development".
DESIGN_PREVIEW="false"

# Password-reset delivery. EMAIL_FROM must use a sender verified with Resend.
RESEND_API_KEY=""
EMAIL_FROM=""

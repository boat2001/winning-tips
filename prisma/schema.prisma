generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Foundational application configuration. Domain models are added in their
/// designated development stages to keep migrations small and reviewable.
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  group       String   @default("general")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

/** A league belongs to exactly one sport, and a fixture inherits it. */
enum Sport {
  FOOTBALL
  BASKETBALL
  TENNIS
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum PredictionVisibility {
  FREE
  PREMIUM
}

enum PredictionPublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PredictionResult {
  PENDING
  WON
  LOST
  VOID
  PUSH
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  TIPSTER
  USER
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum SlipCategory {
  FREE
  VIP1
  VIP2
  VIP3
}

model League {
  id         String    @id @default(cuid())
  externalId String    @unique
  name       String
  slug       String    @unique
  country    String
  sport      Sport     @default(FOOTBALL)
  logoUrl    String?
  fixtures   Fixture[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([country, name])
  @@map("leagues")
}

model Team {
  id           String    @id @default(cuid())
  externalId   String    @unique
  name         String
  shortName    String?
  country      String?
  logoUrl      String?
  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([name])
  @@map("teams")
}

model Fixture {
  id           String        @id @default(cuid())
  externalId   String        @unique
  leagueId     String
  homeTeamId   String
  awayTeamId   String
  kickoffAt    DateTime
  status       FixtureStatus @default(SCHEDULED)
  homeScore    Int?
  awayScore    Int?
  venue        String?
  provider     String        @default("mock")
  providerData Json?
  predictions  Prediction[]
  league       League        @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  homeTeam     Team          @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam     Team          @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([kickoffAt])
  @@index([leagueId, kickoffAt])
  @@index([status, kickoffAt])
  @@map("fixtures")
}

model Deck {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String
  icon             String?
  visualIdentifier String?
  isPremium        Boolean        @default(false)
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  predictions      Prediction[]
  plans            Plan[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([isActive, sortOrder])
  @@map("decks")
}

model Prediction {
  id          String                  @id @default(cuid())
  slug        String                  @unique
  fixtureId   String
  deckId      String?
  market      String
  selection   String
  sourceData  Json?
  odds        Decimal                 @db.Decimal(6, 2)
  confidence  Int
  analysis    String
  visibility  PredictionVisibility    @default(FREE)
  status      PredictionPublishStatus @default(DRAFT)
  result      PredictionResult        @default(PENDING)
  publishAt   DateTime?
  createdById String
  bookingId   String?
  fixture     Fixture                 @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
  deck        Deck?                   @relation(fields: [deckId], references: [id], onDelete: SetNull)
  createdBy   User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  booking     Booking?                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  saves       SavedTip[]

  @@index([fixtureId, status])
  @@index([deckId, status])
  @@index([status, publishAt])
  @@index([visibility, status])
  @@index([bookingId])
  @@map("predictions")
}

model User {
  consents           ConsentRecord[]
  communityPosts CommunityPost[]
  communityReactions CommunityReaction[]
  communityReports CommunityReport[]
  savedTips          SavedTip[]
  preference         UserPreference?
  id                 String               @id @default(cuid())
  username           String               @unique
  email              String               @unique
  passwordHash       String
  displayName        String?
  phone              String?
  role               UserRole             @default(USER)
  emailVerifiedAt    DateTime?
  isActive           Boolean              @default(true)
  lastLoginAt        DateTime?
  predictions        Prediction[]
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  auditLogs          AuditLog[]
  payments           Payment[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([role, isActive])
  @@map("users")
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  priceMinor    Int            @default(0)
  currency      String         @default("GHS")
  deckId        String?
  isActive      Boolean        @default(true)
  isSoldOut     Boolean        @default(false)
  sortOrder     Int            @default(0)
  deck          Deck?          @relation(fields: [deckId], references: [id], onDelete: SetNull)
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isActive, sortOrder])
  @@index([deckId, isActive])
  @@map("plans")
}

model Booking {
  id          String       @id @default(cuid())
  title       String       @default("Booking Code")
  platform    String
  code        String       @unique
  category    SlipCategory @default(FREE)
  shareUrl    String?
  totalOdds   Decimal?     @db.Decimal(12, 2)
  priceMinor  Int?
  /** The country edition this card is sold in. A card is per country, per day, per tier. */
  countryCode String       @default("GH")
  currency    String       @default("GHS")
  isSoldOut   Boolean      @default(false)
  deadline    DateTime?
  bookingDate DateTime     @db.Date
  isActive    Boolean      @default(true)
  deletedAt   DateTime?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  predictions Prediction[]
  payments    Payment[]

  @@index([bookingDate, isActive, sortOrder])
  @@index([category, bookingDate, isActive])
  @@index([countryCode, category, bookingDate, isActive])
  @@index([deletedAt])
  @@map("bookings")
}

model Payment {
  id                String          @id @default(cuid())
  reference         String          @unique
  provider          PaymentProvider @default(PAYSTACK)
  providerReference String?
  userId            String
  planId            String?
  bookingId         String?
  amountMinor       Int
  currency          String
  status            PaymentStatus   @default(PENDING)
  authorizationUrl  String?
  accessCode        String?
  gatewayResponse   String?
  providerData      Json?
  paidAt            DateTime?
  verifiedAt        DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan              Plan?           @relation(fields: [planId], references: [id], onDelete: Restrict)
  booking           Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([bookingId, userId, status])
  @@index([status, createdAt])
  @@index([provider, providerReference])
  @@map("payments")
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuthAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String?
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("auth_attempts")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SavedTip {
  id           String     @id @default(cuid())
  userId       String
  predictionId String
  selection    String?
  market       String?
  revisionAt   DateTime
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  @@unique([userId, predictionId])
  @@index([userId, createdAt])
  @@map("saved_tips")
}

model UserPreference {
  userId        String   @id
  countryCode   String   @default("GH")
  sports        String[] @default([])
  notifications Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_preferences")
}

model CommunityPost {
  id        String @id @default(cuid())
  authorId  String
  parentId  String?
  body      String
  sport     String?
  status    String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent CommunityPost? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityPost[] @relation("Replies")
  reactions CommunityReaction[]
  reports CommunityReport[]
  @@index([status, parentId, createdAt])
  @@map("community_posts")
}
model CommunityReaction {
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@map("community_reactions")
}
model CommunityReport {
  id String @id @default(cuid())
  userId String
  postId String
  reason String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@map("community_reports")
}

enum ConsentKind {
  AGE_CONFIRMATION
  TERMS
  PRIVACY
  MARKETING
}

/// Append-only: a withdrawal is a new row with granted = false, never an update.
model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  kind        ConsentKind
  granted     Boolean
  version     String
  countryCode String
  source      String
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("consent_records")
}

enum AutomationStatus {
  SUCCEEDED
  PARTIAL
  FAILED
  SKIPPED
}

/// One run of a scheduled job: what it did, how it ended, and why.
/// Written by every automation route, so a failed night is visible in admin
/// instead of being discovered from a member's complaint.
model AutomationRun {
  id         String           @id @default(cuid())
  job        String
  status     AutomationStatus
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  summary    Json?
  error      String?

  @@index([job, startedAt])
  @@map("automation_runs")
}
